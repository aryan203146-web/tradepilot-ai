# TradePilot AI — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file or credentials to GitHub!

# Application Mode
APP_MODE=PAPER_TRADING

# Groww Broker API (Optional - for live exchange feeds)
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here

# Risk Limits
MAX_TRADES_PER_DAY=4
MAX_DAILY_LOSS_PCT=3.0
MAX_SINGLE_TRADE_RISK_PCT=2.0
